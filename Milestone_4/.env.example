# ─────────────────────────────────────────────
# SynthAI Milestone 4 — Production Environment Configuration
# ─────────────────────────────────────────────

# Google Gemini API Key (Required for LLM summarization and grounded RAG synthesis)
GEMINI_API_KEY=your_gemini_api_key_here

# Hugging Face Access Token (Optional: for Pyannote speaker diarization)
HF_TOKEN=your_huggingface_access_token_here

# REST API Host and Port Settings
API_HOST=127.0.0.1
API_PORT=8000

# Security & Session Secrets
JWT_SECRET=production_strong_secret_key_change_me_in_prod_2026

# Zoom OAuth & Webhook Credentials
ZOOM_ACCOUNT_ID=your_zoom_account_id
ZOOM_CLIENT_ID=your_zoom_client_id
ZOOM_CLIENT_SECRET=your_zoom_client_secret
ZOOM_WEBHOOK_SECRET_TOKEN=your_zoom_webhook_secret_token

# Google Workspace / Google Drive Credentials
GOOGLE_APPLICATION_CREDENTIALS=path/to/service_account.json
